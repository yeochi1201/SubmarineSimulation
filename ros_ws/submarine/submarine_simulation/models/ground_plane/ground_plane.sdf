<?xml version = "1.0" ?>
<sdf version = "1.9">
    <model name = "ground_plane">
        <static>true</static>
        <link name = "link">
        <!--Collide Size-->
        <collision name = "collision">
            <geometry>
                <plane>
                    <normal>0 0 1</normal>
                    <size>100 100</size>
                </plane>
            </geometry>
        </collision>
        
        <!--Visual Size-->
        <visual name = "visual">
            <geometry>
                <plane>
                    <normal>0 0 1</normal>
                    <size>100 100</size>
                </plane>
            </geometry>
        </visual>
    </model>
</sdf>